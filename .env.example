# ===========================================================================
# Trợ lý Thủ tục hành chính — biến môi trường
# Sao chép thành .env rồi sửa. Mọi biến đều có mặc định trong config.py (ở thư mục gốc).
# ===========================================================================

# ---- Mô hình (Ollama) -----------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
# Thử nhanh: qwen2.5:1.5b  ·  Triển khai (3–4B, 4-bit): qwen2.5:3b
# Mô hình đã fine-tune + lượng tử hoá: tên tạo bằng Utility/finetune/merge_and_export.py
LLM_MODEL=qwen2.5:1.5b
# Để trống = dùng chung LLM_MODEL cho bước kiểm chứng
VERIFIER_MODEL=
LLM_NUM_CTX=8192
LLM_KEEP_ALIVE=30m
LLM_TIMEOUT=120
TEMPERATURE=0.1
TOP_P=0.9
ANSWER_MAX_TOKENS=900
# Kiến thức trong trọng số mô hình dừng ở đâu (ước lượng) — so với ngày của nguồn
MODEL_KNOWLEDGE_CUTOFF=2023-12

# ---- Hai hệ thống trả lời ---------------------------------------------------
# Người dùng chuyển qua lại bằng nút "Web search" trên giao diện; mỗi cuộc trò
# chuyện ghi nhớ hệ thống của nó, đổi hệ thống thì mở ô chat mới.
#   websearch  Hệ thống 1 — tra web .gov.vn qua MCP
#   retrieval  Hệ thống 2 — CSDL thủ tục nội bộ (MẶC ĐỊNH, đúng Proposal)
DEFAULT_SYSTEM=retrieval
# Đặt false để tắt Hệ thống 2: nó sẽ trả lời lịch sự là chưa sẵn sàng và mời
# người dùng bấm nút Web search — không bao giờ bịa câu trả lời.
RETRIEVAL_ENABLED=true

# ---- Hệ thống 2: CSDL thủ tục ----------------------------------------------
# Dựng bằng: python -m Database.pipeline.run_pipeline --all  (~15-25 phút)
# KHÔNG nằm trong git (cả .db lẫn thư mục biểu mẫu) nên máy nào cũng phải cào
# một lần — "Setup First Time.bat" tự làm việc này.
# PROCEDURES_DB_PATH=Database/runtime/procedures.db
# PROCEDURE_FILES_DIR=Database/raw/files

# Số vòng hỏi lại (MCQ) tối đa trước khi trả bảng. Hỏi nhiều thì người dân bỏ
# cuộc; hỏi ít thì dễ trả nhầm thủ tục. 2 là mức đo thấy vừa.
RETRIEVAL_MAX_MCQ_ROUNDS=2
# Số lần cho LLM 1 nghĩ lại từ khoá khi tra không ra (Proposal: quá 3 lượt thì
# xin lỗi, nêu rõ khoá đã tìm + câu hỏi gốc để còn debug được).
RETRIEVAL_MAX_KEY_ATTEMPTS=3
# LLM 2 — chăm sóc khách hàng sau khi đã có bảng. Tắt = chỉ trả bảng, không
# cho mô hình nói thêm câu nào (an toàn nhất, nhưng khô khan).
RETRIEVAL_FOLLOWUP_ENABLED=true

# ---- Hiểu ý định / hỏi lại -------------------------------------------------
CLARIFY_ENABLED=true
# Ví dụ mẫu cho bước hiểu ý định. Đặt false khi dùng mô hình đã fine-tune bằng Utility/finetune/
UNDERSTAND_FEWSHOT=true

# ---- MCP + tìm kiếm ---------------------------------------------------------
# stdio: app tự bật MCP server làm tiến trình con (chạy local)
# http : nối tới MCP server riêng ở MCP_SERVER_URL (Docker tự đặt)
# direct: gọi thẳng engine, không qua MCP (chỉ để gỡ lỗi)
MCP_TRANSPORT=stdio
MCP_SERVER_URL=http://127.0.0.1:8765/mcp
MCP_TIMEOUT=60
MCP_FALLBACK_DIRECT=true

# ddgs (không cần key) | searxng (cần SEARXNG_URL) | brave | tavily (cần SEARCH_API_KEY)
SEARCH_PROVIDER=ddgs
SEARCH_API_KEY=
SEARXNG_URL=
SEARCH_REGION=vn-vi
SEARCH_MAX_QUERIES=3
SEARCH_RESULTS_PER_QUERY=8
SEARCH_TIMEOUT=10
# Hạn chót chung cho các truy vấn song song (vẫn chờ tới khi có ít nhất một kết quả, tối đa 30s)
SEARCH_DEADLINE=9
# Trần tuyệt đối cho cả bước tra cứu, phải nhỏ hơn MCP_TIMEOUT
SEARCH_TOTAL_BUDGET=25
# Chỉ cho ddgs: auto | duckduckgo | brave | google | bing | yandex ... (phân tách dấu phẩy)
SEARCH_DDGS_BACKEND=auto
SEARCH_CACHE_SECONDS=1800
# true = chỉ nhận nguồn chính thống (.gov.vn, chinhphu.vn, vbpl.vn...)
SEARCH_OFFICIAL_ONLY=false
FETCH_TOP_N=6
FETCH_TIMEOUT=8
# Trang nào đọc chậm hơn mức này thì dùng snippet của kết quả tìm kiếm
FETCH_DEADLINE=6
EVIDENCE_TOP_K=5
EVIDENCE_MAX_CHARS=7000
EVIDENCE_SOURCE_CHARS=1800
# Xếp hạng nguồn (khớp tên miền và tên miền con)
OFFICIAL_DOMAINS=gov.vn,chinhphu.vn,baochinhphu.vn,vbpl.vn,quochoi.vn
LEGAL_DOMAINS=thuvienphapluat.vn,luatvietnam.vn
BLOCKED_DOMAINS=facebook.com,youtube.com,tiktok.com,instagram.com,x.com,twitter.com,pinterest.com,reddit.com,scribd.com,shopee.vn

# ---- Kiểm chứng -------------------------------------------------------------
VERIFIER_ENABLED=true
MAX_VERIFY_RETRIES=1
# warn: vẫn trả lời nhưng gắn cảnh báo + chi tiết chưa khớp · refuse: "Không đủ thông tin để xác nhận"
VERIFY_FAIL_POLICY=warn

# ---- Bộ nhớ hội thoại ---------------------------------------------------------
SUMMARY_ENABLED=true
MAX_CONTEXT_TOKENS=3000
SUMMARY_KEEP_RECENT=5
PROFILE_MEMORY_ENABLED=true

# ---- Ứng dụng ---------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000
# DATABASE_PATH=Database/runtime/app.db
# RUNTIME_DIR=Database/runtime
# Lớp lưu trữ: sqlite (mặc định). Đổi khi làm CSDL đầy đủ về sau.
# DB_BACKEND=sqlite
RETENTION_DAYS=90
AUTH_ENABLED=true
AUTH_COOKIE_SECURE=false
QUEUE_ENABLED=true
QUEUE_CONCURRENCY=1
QUEUE_MAX_DEPTH=20
QUEUE_JOB_TIMEOUT=180
ATTACHMENTS_ENABLED=true
# ĐẶT false ở bản bàn giao
DEV_TOOLS_ENABLED=true

# ---- Chỉ dùng cho docker compose --------------------------------------------
# Dùng Ollama chạy sẵn trên máy thay vì container: http://host.docker.internal:11434
# OLLAMA_HOST_DOCKER=http://ollama:11434
